{
  "name": "Message",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "note",
        "activity"
      ],
      "default": "inbound"
    },
    "body": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "chat",
        "phone"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reactions": {
      "type": "object",
      "description": "Emoji reactions: { 'emoji': [{ id, name }, ...] }"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "body",
    "type"
  ]
}
