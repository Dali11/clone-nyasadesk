{
  "name": "Reminder",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "remind_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string"
    },
    "is_done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "remind_at"
  ]
}