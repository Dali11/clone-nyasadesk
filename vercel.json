{
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth?path=$1"
    },
    {
      "source": "/api/webhooks/(.*)",
      "destination": "/api/webhooks?channel=$1"
    },
    {
      "source": "/api/storage/object/(.*)",
      "destination": "/api/storage?op=object&path=$1"
    },
    {
      "source": "/api/storage/upload",
      "destination": "/api/storage?op=upload"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/webhooks.js": {
      "maxDuration": 60
    }
  }
}
