{
  "rewrites": [
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth?path=$1"
    },
    {
      "source": "/api/storage/object/(.*)",
      "destination": "/api/storage/object?path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/webhooks/whatsapp.js": {
      "maxDuration": 60
    }
  }
}